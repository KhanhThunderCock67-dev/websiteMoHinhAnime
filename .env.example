# ==============================================================================
# HOBBY VAULT (MERN STACK) - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Cấu hình biến môi trường khi deploy lên Railway
# ==============================================================================

# ==============================================================================
# PHẦN 1: CÁC BIẾN CẦN NHẬP TRÊN RAILWAY CHO BACKEND (SERVICE: SERVER)
# ==============================================================================
NODE_ENV=production
# (Lưu ý: Biến PORT do Railway tự động gán, KHÔNG cần điền tay vào Railway Variables)

# Kết nối MongoDB (Atlas Cloud hoặc Railway MongoDB Plugin)
MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword@cluster0.abcde.mongodb.net/hobby_ecommerce?retryWrites=true&w=majority

# Chuỗi bí mật ký JWT Token (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=railway_prod_hobby_vault_jwt_secret_key_2026_super_secure
JWT_EXPIRE=30d

# Domain Frontend được phép gọi API (Vercel, Railway, Netlify,...)
# Hỗ trợ nhiều URL cách nhau bằng dấu phẩy
CLIENT_URL=https://your-frontend-app.vercel.app

# Tích hợp AI Chatbot
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# (Nếu dùng OpenAI thay vì Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# PHẦN 2: CÁC BIẾN CẦN NHẬP CHO FRONTEND (CLIENT TRÊN VERCEL HOẶC RAILWAY)
# ==============================================================================
# Đường dẫn API Backend trên Railway (nhớ kèm /api ở cuối)
VITE_API_URL=https://your-backend-production.up.railway.app/api
