# ==============================================================================
# HOBBY VAULT BACKEND - ENVIRONMENT CONFIGURATION (.env.example)
# Dùng cho cấu hình môi trường Local và Deploy trên Railway
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER ENVIRONMENT & PORT
# ------------------------------------------------------------------------------
# Trên Railway: đặt NODE_ENV=production
# Local: development
NODE_ENV=production

# Cổng khởi chạy Server
# LƯU Ý KHI DEPLOY RAILWAY:
# Railway sẽ TỰ ĐỘNG cấp biến PORT ngẫu nhiên vào runtime.
# Bạn KHÔNG CẦN tạo hoặc ghi đè PORT trên giao diện Railway Variables!
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB)
# ------------------------------------------------------------------------------
# Cách 1 (Khuyên dùng): Dùng MongoDB Atlas Cloud (Free tier M0)
# Định dạng: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin_user:YourStrongPassword@cluster0.abcde.mongodb.net/hobby_ecommerce?retryWrites=true&w=majority

# Cách 2: Nếu bạn thêm service MongoDB trực tiếp trên Railway:
# Railway sẽ tự động tạo biến MONGO_URL. Backend code đã hỗ trợ tự nhận diện MONGO_URL.
# Bạn có thể dùng: MONGO_URL=${{MongoDB.MONGO_URL}} hoặc copy Connection String từ MongoDB service.
# MONGO_URL=mongodb://mongo:password@mongo.railway.internal:27017

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Chuỗi bí mật dùng để mã hóa JSON Web Token (bắt buộc đổi thành chuỗi ngẫu nhiên dài, an toàn trong production)
# Gợi ý tạo chuỗi bí mật: Chạy `openssl rand -hex 32` hoặc gõ chuỗi bất kỳ dài trên 32 ký tự
JWT_SECRET=railway_prod_hobby_vault_jwt_secret_key_2026_super_secure

# Thời gian hết hạn của JWT (ví dụ: 30d, 7d, 24h)
JWT_EXPIRE=30d

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
# Đường dẫn domain của Frontend để Backend cho phép CORS gọi API
# - Nếu deploy Frontend trên Vercel: https://your-app.vercel.app
# - Nếu deploy Frontend trên Railway: https://your-client-production.up.railway.app
# - Có thể điền nhiều URL cách nhau bằng dấu phẩy (vd: https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# 5. AI CHATBOT ASSISTANT (GOOGLE GEMINI / OPENAI)
# ------------------------------------------------------------------------------
# Nhà cung cấp AI: 'gemini' (Khuyên dùng - miễn phí & phản hồi nhanh) hoặc 'openai'
AI_PROVIDER=gemini

# Google Gemini API: Lấy key miễn phí tại https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API: (Chỉ cần nếu AI_PROVIDER=openai, lấy tại https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
